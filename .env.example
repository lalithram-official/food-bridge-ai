# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Default Gemini Flash model used by the server AI service.
GEMINI_MODEL="gemini-4-hydrogen"

# CERTIFICATE_SIGNING_SECRET: Server-side HMAC-SHA256 secret for Donation Certificates.
CERTIFICATE_SIGNING_SECRET="change-me-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
